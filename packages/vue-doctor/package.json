{
  "name": "@remylagerweij/vue-doctor",
  "version": "2.0.1",
  "description": "Diagnose and fix performance issues in your Vue.js app",
  "keywords": [
    "diagnostics",
    "linter",
    "nuxt",
    "performance",
    "vue"
  ],
  "homepage": "https://github.com/remylagerweij/vue-doctor#readme",
  "bugs": {
    "url": "https://github.com/remylagerweij/vue-doctor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remylagerweij/vue-doctor.git",
    "directory": "packages/vue-doctor"
  },
  "bin": {
    "vue-doctor": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint-plugin": {
      "types": "./dist/vue-doctor-plugin.d.ts",
      "default": "./dist/vue-doctor-plugin.js"
    },
    "./package.json": "./package.json",
    "./schema.json": "./schema/vue-doctor.schema.json",
    "./report-schema.json": "./schema/report.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown --watch",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "rules:generate": "node scripts/generate-rules.mjs",
    "rules:table": "jiti scripts/generate-rules-table.ts",
    "docs:gen": "jiti scripts/generate-all-docs.ts",
    "snapshot:update": "vitest run tests/fixture-snapshots.test.ts -u",
    "benchmark": "node scripts/benchmark/benchmark.mjs",
    "schema:update": "vitest run tests/config.test.ts tests/report.test.ts -u"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "knip": "^6.39.0",
    "oxlint": "1.86.0",
    "picocolors": "^1.1.1",
    "vue-eslint-parser": "^10.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^20.14.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
